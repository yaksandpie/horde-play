{
  "name": "horde-play-tests",
  "private": true,
  "type": "module",
  "description": "Test tooling for Horde Play. Kept separate from the build so the app itself stays free of runtime dependencies.",
  "scripts": {
    "check": "node ../build.mjs && node check-static.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "serve": "node ../build.mjs && node serve.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.62.1"
  }
}
